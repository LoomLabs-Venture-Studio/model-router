@@ -1,11 +1,35 @@
+import re
+
 from fastapi import Header, HTTPException
 
-def require_auth(authorization: str = Header(None)):
+
+def require_auth(authorization: str = Header(None)) -> str:
     if not authorization or not authorization.startswith("Bearer "):
         raise HTTPException(401, "missing token")
     return authorization.split(" ", 1)[1]
 
-def require_admin(token: str):
-    if token != "admin-token":
+
+def identify(token: str) -> tuple[str, int | None]:
+    """Returns ("admin", None) or ("user", id). A token that is neither
+    admin-token nor user-<positive integer> is unauthenticated (401), not
+    merely unauthorized -- this applies everywhere, including admin routes."""
+    if token == "admin-token":
+        return "admin", None
+    m = re.fullmatch(r"user-(\d+)", token)
+    if not m:
+        raise HTTPException(401, "invalid token")
+    return "user", int(m.group(1))
+
+
+def require_admin(token: str) -> None:
+    kind, _ = identify(token)
+    if kind != "admin":
         raise HTTPException(403, "admin only")
-    return token
+
+
+def require_owner_or_admin(token: str, owner_id: int) -> None:
+    kind, caller_id = identify(token)
+    if kind == "admin":
+        return
+    if caller_id != owner_id:
+        raise HTTPException(403, "not allowed")
